{
  "name": "c-viz-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "env:check": "node scripts/environment.mjs",
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json tsconfig.web.json tsconfig.tools.json vite.config.ts eslint.config.mjs .prettierrc.json web/index.html web/src scripts/*.{mjs,mts} tests content/README.md shared/fixtures/README.md",
    "format": "prettier --write package.json package-lock.json tsconfig.json tsconfig.web.json tsconfig.tools.json vite.config.ts eslint.config.mjs .prettierrc.json web/index.html web/src scripts/*.{mjs,mts} tests content/README.md shared/fixtures/README.md",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:fixtures": "node 项目文档/验收/02.4-共享资料检查.mjs",
    "test:schemas": "pwsh -NoProfile -File 项目文档/验收/02.4-Schema验证.ps1",
    "check:rust": "node scripts/rust-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:content": "node scripts/build-content.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "browser:install": "playwright install firefox",
    "test:firefox-stable": "node scripts/firefox-stable.mjs",
    "test:startup": "node scripts/startup-check.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "blockly": "13.4.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@codemirror/language": "6.13.1",
    "@codemirror/lang-cpp": "6.0.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.0"
  }
}
