{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"d0614714ac5673bfbd7c8b512dd35b39661da9b40993aefdd13e6a2f0b8d04ae","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"6292b01b-8ec3-405c-84a0-a84c5a950482","contextRevision":5,"runId":"1df57b1a-2d2e-43d7-b632-69aa1da8634a","sourceRevision":5,"submissionId":"2000ec9c-f5e6-4caa-a216-049d35f6c6c6","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.loop-count","version":"1.0.0"},"values":{"n":5}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p0","version":"1.0.0"},"programRef":{"id":"program.c.two-loop-sums","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":998,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int i = 1;\n    int sumWhile = 0;\n    while (i <= n) {\n        sumWhile = sumWhile + i;\n        i = i + 1;\n    }\n    int sumFor = 0;\n    for (int j = 1; j <= n; j = j + 1) {\n        sumFor = sumFor + j;\n    }\n    printf(\"%d\\n%d\\n\", sumWhile, sumFor);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.loops","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}