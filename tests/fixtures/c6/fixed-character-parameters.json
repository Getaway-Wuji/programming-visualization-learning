    {
      "id": "lib15.unsigned-expression",
      "title": "unsigned-expression",
      "mode": "execute",
      "input": "",
      "files": [
        {
          "name": "main.c",
          "source": "#include <stdio.h>\nint main(){unsigned value=13u;for(int bit=7;bit>=0;--bit)putchar('0'+((value>>bit)&1u));putchar(10u);return 0;}\n"
        }
      ],
      "expectedStdout": "00001101\n",
      "expectedReturn": 0
    },
