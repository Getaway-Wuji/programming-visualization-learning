leOccurrence":6,"role":"example-caption","anchor":null,"sourceRef":"https://www.runoob.com/java/java-loop.html","sourceSha256":"4b109507b7eb3fb6ad3aa515c0651134414e74d7f069dae5987c559df7e5c8c6","questionId":null,"articleSourceOrder":12,"status":"context-only","platformRef":{"id":"java.source.76d322eeba6c4ea199ca","version":"1.0.0"},"reason":"原例子标题与父子位置。"}],"examples":[{"id":"java.example.ef07f951e5f66d257c0b","lessonId":"java.lesson.ef07f951e5f66d257c0b","status":"runnable-required","reason":"可用 Java Rust/WASM 执行并查看真实轨迹。","source":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner input = new Scanner(System.in);\n        int limit = input.nextInt();\n        int total = 0;\n        int odd = 1;\n        while (odd <= limit) {\n            total = total + odd;\n            odd = odd + 2;\n        }\n        System.out.println(total);\n    }\n}","sourceSha256":"bca1fc2bcf36f8dc174be5d205f7448b93076a8c8e85611816d6d0f37dbb2888","cases":[{"name":"输入 1","input":"0","stdout":"0\n"},{"name":"输入 2","input":"1","stdout":"1\n"},{"name":"输入 3","input":"6","stdout":"9\n"},{"name":"输入 4","input":"15","stdout":"64\n"}]},{"id":"java.example.e229e6a09eea7fa42a25","lessonId":"java.lesson.e229e6a09eea7fa42a25","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"完整 Java 中 int n=0; do { n=n+1; } while(n<0); 后 n 是多少？","result":"n 为 1。第一次更新发生在条件判断之前。"},{"id":"java.example.f57679525ac914eb24e1","lessonId":"java.lesson.f57679525ac914eb24e1","status":"runnable-required","reason":"可用 Java Rust/WASM 执行并查看真实轨迹。","source":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner input = new Scanner(System.in);\n        int limit = input.nextInt();\n        int product = 1;\n        for (int i = 1; i <= limit; i++) {\n            product = product * i;\n        }\n        System.out.println(product);\n    }\n}","sourceSha256":"db9d69dc211eac61d7769637088050f536a4e2ccb2188a5c