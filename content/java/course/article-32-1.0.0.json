8d98579d3a69af41ef7b8a6180aa8369102a0fc7021348e1b03dc13d38","questionId":null,"articleSourceOrder":32,"status":"authored","platformRef":{"id":"java.lesson.9e4455789dae0d05b7a4","version":"1.0.0"},"goal":"把标记接口理解为供框架判断的类型能力。","body":["标记接口可无普通方法，例如历史上用于声明对象能参与某个机制。是否真正安全或可用还由该机制的约束决定。"],"reason":"依原目录原创改写并保留出处。","leaf":true,"exampleId":"java.example.9e4455789dae0d05b7a4","activityId":"java.check.9e4455789dae0d05b7a4"}],"examples":[{"id":"java.example.2acfa780dc0431302025","lessonId":"java.lesson.2acfa780dc0431302025","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"可以把 interface Trackable 作为函数参数类型吗？","result":"可以。调用者传入一个实现该接口的实际对象。"},{"id":"java.example.e8d1b09ee56ab87ec6ba","lessonId":"java.lesson.e8d1b09ee56ab87ec6ba","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"多个对象各有一个可变 score，应把它声明为接口字段吗？","result":"不应。把 score 放在各实现类实例，接口可约定访问行为。"},{"id":"java.example.de97984a5d6e533c2a64","lessonId":"java.lesson.de97984a5d6e533c2a64","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"接口 T 声明 static int limit()，调用处常用 T.limit() 还是通过任意对象调用？","result":"使用 T.limit()，因为该方法属于接口。"},{"id":"java.example.58f2aab4e2ec0a3c15e6","lessonId":"java.lesson.58f2aab4e2ec0a3c15e6","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"狗和无人机都能 track，是否需要共享同一个抽象父类？","result":"可用 Trackable 接口表达这一能力。各自仍可保留不同的父类与状态。"},{"id":"java.example.7376df8b6380eb0e9be4","lessonId":"java.lesson.7376df8b6380eb0e9be4","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"interface Payable { int amount(); } 对实现类提出什么要求？","result":"具体实现需要提供可公开调用、返回 int 的 amount()，或继承满足要求的实现。"},{"id":"java.example.4f53bba49218f1d2b647","lessonId":"java.lesson.4f53bba49218f1d2b647","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"interface Switch { boolean isOn(); }，以 Switch 类型调用 isOn 是否需要知道类名？","result":"不需要。签名已定义在接口中，结果由实际对象的实现决定。"},{"id":"java.example.5eb887810589168294e8","lessonId":"java.lesson.5eb887810589168294e8","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"类声称 implements Printable，却没有 print() 实现，什么时候仍可编译？","result":"可以是抽象类并继续将义务交给子类，或继承到有效实现；具体类不能缺少所需方法。"},{"id":"java.example.2def07cbcd7e7437c350","lessonId":"java.lesson.2def07cbcd7e7437c350","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"接口 LogSink 提供 void write(String)，FileSink 可以只定义 write(int) 吗？","result":"不能。参数类型不同，不满足规定签名。"},{"id":"java.example.43a0828d9c6604e90898","lessonId":"java.lesson.43a0828d9c6604e90898","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"interface Advanced extends Basic，Advanced 的实现可赋给 Basic 吗？","result":"可以。它也承诺了 Basic 的合同。"},{"id":"java.example.3f7536a2dd4ae9d6b3be","lessonId":"java.lesson.3f7536a2dd4ae9d6b3be","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"两个无关接口各有同签名 default id()，一个类同时实现两者，编译器会随意挑一个吗？","result":"不会。类必须解决冲突并表达其实际实现。"},{"id":"java.example.9e4455789dae0d05b7a4","lessonId":"java.lesson.9e4455789dae0d05b7a4","status":"reading-only","reason":"本节通过完整情景静态推演。","prompt":"一个类型实现 Serializable 就意味着其所有对象图必能保存吗？","result":"不意味着。实际对象图中的成员、版本和序列化规则仍可能导致失败。"}],"activities":[{"id":"java.check.2acfa780dc0431302025","lessonId":"java.lesson.2acfa780dc0431302025","kind":"optional-self-check","exampleId":"java.example.2acfa780dc0431302025","prompt":"可以把 interface Trackable 作为函数参数类型吗？","reveal":"可以。调用者传入一个实现该接口的实际对象。"},{"id":"java.check.e8d1b09ee56ab87ec6ba","lessonId":"java.lesson.e8d1b09ee56ab87ec6ba","kind":"optional-self-check","exampleId":"java.example.e8d1b09ee56ab87ec6ba","prompt":"多个对象各有一个可变 score，应把它声明为接口字段吗？","reveal":"不应。把 score 放在各实现类实例，接口可约定访问行为。"},{"id":"java.check.de97984a5d6e533c2a64","lessonId":"java.lesson.de97984a5d6e533c2a64","kind":"optional-self-check","exampleId":"java.example.de97984a5d6e533c2a64","prompt":"接口 T 声明 static int limit()，调用处常用 T.limit() 还是通过任意对象调用？","reveal":"使用 T.limit()，因为该方法属于接口。"},{"id":"java.check.58f2aab4e2ec0a3c15e6","lessonId":"java.lesson.58f2aab4e2ec0a3c15e6","kind":"optional-self-check","exampleId":"java.example.58f2aab4e2ec0a3c15e6","prompt":"狗和无人机都能 track，是否需要共享同一个抽象父类？"