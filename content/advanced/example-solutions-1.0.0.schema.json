{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "examples"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "catalog.advanced.multi-solutions"
    },
    "version": {
      "const": "1.0.0"
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exampleRef", "solutions", "supplementalSamples"],
        "properties": {
          "exampleRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "version": {
                "const": "1.0.0"
              }
            }
          },
          "solutions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "solutionRef",
                "programRef",
                "sourceFile",
                "title",
                "strategy",
                "time",
                "space",
                "derivation",
                "suitable",
                "cautions"
              ],
              "properties": {
                "solutionRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "version": {
                      "const": "1.0.0"
                    }
                  }
                },
                "programRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "version": {
                      "const": "1.0.0"
                    }
                  }
                },
                "sourceFile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "time": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "space": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "derivation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "suitable": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "cautions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "supplementalSamples": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "values", "expectedStdout", "expectedReturn"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "integer",
                    "minimum": -999,
                    "maximum": 999
                  }
                },
                "target": {
                  "type": "integer",
                  "minimum": -999,
                  "maximum": 999
                },
                "expectedStdout": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "expectedReturn": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
