        "id": "case.c.selection-sort",
        "version": "1.0.2",
        "title": "选择排序",
        "languageRef": {
          "id": "lang.c",
          "version": "1.0.0"
        },
        "kind": "algorithm",
        "learningRevision": 1,
        "acceptedPriorVersions": [
