        "programRef": {
          "id": "program.c.selection-sort",
          "version": "1.0.1"
        },
        "teaching": {
          "objectives": [
            "观察剩余区最小下标和非自交换"
          ],
          "explanation": "每轮先记住剩余区第一个下标，扫描发现严格更小的值才更新最小下标；最后仅在位置不同时交换。默认[7,-3,0,5,-3,2,9]成为[-3,-3,0,2,5,7,9]。同值保留首次最小下标，但远距离交换可能改变相等元素的相对次序，因此不承诺稳定。空数组只输出换行。",
          "exampleProgramRefs": [
            {
              "id": "program.c.selection-sort",
              "version": "1.0.1"
            }
          ],
          "commonMistakes": [
            "宣称稳定排序",
            "自交换计为真实交换"
          ],
          "boundaryNotes": [
            "空、单项、已序、逆序、重复、负数；n最多30",
            "输出规范与冒泡相同"
          ],
          "source": {
            "document": "content/c/p0/README.md",
            "locator": "case.c.selection-sort；项目原创；沿用08.4已验证程序"
          }
        },
        "resultRule": "selection-ascending",
