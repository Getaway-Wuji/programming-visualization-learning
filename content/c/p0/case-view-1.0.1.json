        "teaching": {
          "objectives": [
            "在非递减数组中找首次0基下标"
          ],
          "explanation": "数组必须非递减，手动乱序会被拒绝。使用闭区间[left,right]与中点left+(right-left)/2；遇到目标先记下位置，再到左侧找更早匹配。默认[-2,0,0,4,8]查0得到0基下标1；未找到和空数组都返回-1，输出后换行。不能遇到相等就立即返回中点。",
          "exampleProgramRefs": [
            {
              "id": "program.c.binary-search-first",
              "version": "1.0.0"
            }
          ],
          "commonMistakes": [
            "手动乱序被静默排序",
            "重复命中返回任意位置"
          ],
          "boundaryNotes": [
            "空/未命中输出-1和换行",
            "首尾/重复/范围外；n最多30"
          ],
          "source": {
