ython3 运算符","实例"],"titleOccurrence":2,"role":"example-caption","anchor":null,"sourceRef":"https://www.runoob.com/python3/python3-basic-operators.html","sourceSha256":"57b188a3147a572e1a4ad38702347e504b4ec45007cfefe225f7ac33df3c4b81","articleSourceOrder":11,"platformRef":{"id":"py3.section.4caed03590d664e0e90ddc94","version":"1.0.0"},"profile":"mixed-core","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","status":"context-only"}],"examples":[{"id":"py3.section.9da753793c34c94d8341252e.example","lessonId":"py3.section.9da753793c34c94d8341252e","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"整数 1+2 和文本 '1'+'2' 分别得到什么？","result":"前者得到 3，后者得到 '12'。"},{"id":"py3.section.8aaac20918365b69d373d182.example","lessonId":"py3.section.8aaac20918365b69d373d182","status":"runnable-required","reason":"原创完整程序，使用同一受限 Rust/WASM 实际运行","source":"n = int(input())\nb = int(input())\n# 用同一对操作数计算商、余数，再复原被除数。\nq = n // b\nr = n % b\nprint(q, r)\nprint(b * q + r)","sourceSha256":"90f4d001afbeb3dd345359e1b964f66d33146e85236ae9a4d458f291840fbf5e","cases":[{"name":"负被除数","input":"-8\n3\n","stdout":"-3 1\n-8\n"},{"name":"负除数","input":"8\n-3\n","stdout":"-3 -1\n8\n"},{"name":"整除无余数","input":"-6\n-3\n","stdout":"2 0\n-6\n"},{"name":"除数为零","input":"4\n0\n","stdout":"","diagnostic":"E_PY_ZERO_DIVISION"}]},{"id":"py3.section.3a2b4087e64c0dc020a4d69b.example","lessonId":"py3.section.3a2b4087e64c0dc020a4d69b","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"0 < x < 10 能接受 x=10 吗？","result":"不能，右端是严格小于。"},{"id":"py3.section.75f69831c13fa244104843dc.example","lessonId":"py3.section.75f69831c13fa244104843dc","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"n=7 后执行 n-=2，n 的新值是什么？","result":"5。"},{"id":"py3.section.394a307bff7058706517a882.example","lessonId":"py3.section.394a307bff7058706517a882","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"用 4 作为掩码检查 13 的第 2 位，13 & 4 是多少？","result":"4，表示这一位已置位。"},{"id":"py3.section.2d90da89bc2f9df6da020874.example","lessonId":"py3.section.2d90da89bc2f9df6da020874","status":"runnable-required","reason":"原创完整程序，使用同一受限 Rust/WASM 实际运行","source":"groups = int(input())\n# 只有分组数为真值时，才计算每组分到几件。\nprint(groups and 17 // groups)","sourceSha256":"0c413dc54c9999bb108c32484a28e83b19766adba094fd77c3fe00a51088da3b","cases":[{"name":"短路保留左值","input":"0\n","stdout":"0\n"},{"name":"右侧真正执行","input":"4\n","stdout":"4\n"},{"name":"负数也是真值","input":"-4\n","stdout":"-5\n"}]},{"id":"py3.section.a94076acc99359b1d7248f5b.example","lessonId":"py3.section.a94076acc99359b1d7248f5b","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"有字典 {'apples': 2}，2 in 字典能查到值吗？","result":"不能，成员判断查键，需另查值。"},{"id":"py3.section.adc7935ff4a4205ad57f8d85.example","lessonId":"py3.section.adc7935ff4a4205ad57f8d85","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"a=[7]，b=[7]，a is b 为真吗？","result":"为假。两次列表字面量创建两个对象。"},{"id":"py3.section.6387152cf5b6e62509e50b45.example","lessonId":"py3.section.6387152cf5b6e62509e50b45","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"2+3*4 与 (2+3)*4 分别是多少？","result":"分别为 14 和 20。"}],"activities":[{"id":"py3.section.9da753793c34c94d8341252e.check","lessonId":"py3.section.9da753793c34c94d8341252e","kind":"optional-self-check","exampleId":"py3.section.9da753793c34c94d8341252e.example","prompt":"整数 1+2 和文本 '1'+'2' 分别得到什么？","reveal":"前者得到 3，后者得到 '12'。"},{"id":"py3.practice.floor-pair","lessonId":"py3.section.8aaac20918365b69d373d182","kind":"rust-judge","profileRef":{"id":"py3.practice.floor-pair","version":"1.0.0"},"title":"同一对整数的整除和余数","task":"逐行读取 a 和非零 b。按顺序输出 a // b 和 a % b，各占一行。","observation":"对两个读入值各真实计算一次整除和取余","hints":["让两次运算读取同一对输入，保留商和余数两个结果。","用 7 与 -3 检验符号。先猜商，再用 a − b × 商求余数并与 % 比较。按题意将两项分行输出。"],"caseCount":4},{"id":"py3.section.3a2b4087e64c0dc020a4d69b.check","lessonId":"py3.section.3a2b4087e64c0dc020a4d69b","kind":"optional-self-check","exampleId":"py3.section.3a2b4087e64c0dc020a4d69b.example","prompt":"0 < x < 10 能接受 x=10 吗？","reveal":"不能，右端是严格小于。"},{"id":"py3.section.75f69831c13fa244104843dc.check","lessonId":"py3.section.75f69831c13fa244104843dc","kind":"optional-self-check","exampleId":"py3.section.75f69831c13fa244104843dc.example","prompt":"n=7 后执行 n-=2，n 的新值是什么？","reveal":"5。"},{"id":"py3.section.394a307bff7058706517a882.check","lessonId":"py3.section.394a307bff7058706517a882","kind":"optional-self-check","exampleId":"py3.section.394a307bff7058706517a882.example","prompt":"用 4 作为掩码检查 13 的第 2 位，13 & 4 是多少？","reveal":"4，表示这一位已置位。"},{"id":"py3.practice.short-circuit","lessonId":"py3.section.2d90da89bc2f9df6da020874","kind":"rust-judge","profileRef":{"id":"py3.practice.short-circuit","version":"1.0.0"},"title":"短路表达式保护除数","task":"逐行读取 a、b。用一个 and 表达式在 b 为零时得到 b，否则得到 a // b，输出该表达式的结果。","observation":"and 的右操作数在除数为零时未执行，其他输入真实进入右操作数","hints":["把可能为零的除数放在 and 左边。","先跑除数 0，观察右侧有没有执行，再跑一个非零除数。直接比较除数是否为零会使短路返回布尔值，和题目要求的数值不同。"],"caseCount":4},{"id":"py3.section.a94076acc99359b1d7248f5b.check","lessonId":"py3.section.a94076acc99359b1d7248f5b","kind":"optional-self-check","exampleId":"py3.section.a94076acc99359b1d7248f5b.example","prompt":"有字典 {'apples': 2}，2 in 字典能查到值吗？","reveal":"不能，成员判断查键，需另查值。"},{"id":"py3.section.adc7935ff4a4205ad57f8d85.check","lessonId":"py3.section.adc7935ff4a4205ad57f8d85","kind":"optional-self-check","exampleId":"py3.section.adc7935ff4a4205ad57f8d85.example","prompt":"a=[7]，b=[7]，a is b 为真吗？","reveal":"为假。两次列表字面量创建两个对象。"},{"id":"py3.section.6387152cf5b6e62509e50b45.check","lessonId":"py3.section.6387152cf5b6e62509e50b45","kind":"optional-self-check","exampleId":"py3.section.6387152cf5b6e62509e50b45.example","prompt":"2+3*4 与 (2+3)*4 分别是多少？","reveal":"分别为 14 和 20。"}],"references":[],"diagrams":[{"title":"短路判断","steps":["求左操作数的真值","根据 and/or 判定是否需要右操作数","返回选中的操作数"],"origin":"platform-original"}]}
