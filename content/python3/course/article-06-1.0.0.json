/python3-basic-syntax.html","sourceSha256":"20806d464dd8ccdebaf9ce7d679b70433d37cd1ca8217e74657c5caf2d664051","articleSourceOrder":6,"platformRef":{"id":"py3.section.d681894cb19c2e1964ea2776","version":"1.0.0"},"profile":"mixed-core","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","leaf":true,"activityId":"py3.section.d681894cb19c2e1964ea2776.check","exampleId":"py3.section.d681894cb19c2e1964ea2776.example","questionId":null,"status":"authored","goal":"能用本节规则解答“执行脚本时在文件名后加 report.txt，input 会直接读到它吗？”","body":["命令行参数来自启动命令。它与程序运行期间读取的标准输入不同。"]}],"examples":[{"id":"py3.section.be3a9f33f4919edf3584d13f.example","lessonId":"py3.section.be3a9f33f4919edf3584d13f","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"源文件保存为其他编码且包含中文，改变输出变量名会解决解析问题吗？","result":"不会。应核对实际文件编码与声明，本平台源码使用 UTF-8。"},{"id":"py3.section.7311ffeebcf2d9ac54125d9e.example","lessonId":"py3.section.7311ffeebcf2d9ac54125d9e","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"count 和 Count 会共享一个变量值吗？","result":"不会。它们是两个不同的名字。"},{"id":"py3.section.61a75b85dea545cf4e6320f1.example","lessonId":"py3.section.61a75b85dea545cf4e6320f1","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"想用 class 作变量名，改成 class_name 会改变什么？","result":"class_name 是可绑定的标识符，原先的 class 会被解析成关键字。"},{"id":"py3.section.8accf08638730e9fb677560c.example","lessonId":"py3.section.8accf08638730e9fb677560c","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"print('编号#3') 里的井号会截断字符串吗？","result":"不会。它位于字符串内部，会原样输出。"},{"id":"py3.section.8a26d37c31e373f273321ff0.example","lessonId":"py3.section.8a26d37c31e373f273321ff0","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"两行 print 只有第一行缩在 if 下，条件为假时会怎样？","result":"第一行跳过，第二行若回到外层仍会运行。"},{"id":"py3.section.6b8a553ad6fc175b5a12f742.example","lessonId":"py3.section.6b8a553ad6fc175b5a12f742","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"想把两项相加拆成两行，优先用什么界定表达式？","result":"用圆括号包住完整表达式。平台支持括号内的续行。"},{"id":"py3.section.6acc652941d077fd36639f7b.example","lessonId":"py3.section.6acc652941d077fd36639f7b","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"为什么 3 和 3.0 输出不同？","result":"前者是整数，后者是浮点值，输出保留了数值类型的区别。"},{"id":"py3.section.4fd31f0a63342e79b75ede69.example","lessonId":"py3.section.4fd31f0a63342e79b75ede69","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"希望显示一对引号包围的名字，如何减少转义？","result":"用不同的外层引号包住含引号的文字，内部引号就可原样写出。"},{"id":"py3.section.01558fd56394beea79eb976f.example","lessonId":"py3.section.01558fd56394beea79eb976f","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"在同一缩进的两条语句间插入空行，会自动结束 if 块吗？","result":"不会。下一条实质语句的缩进决定块是否结束。"},{"id":"py3.section.8743926740ea88241a956da7.example","lessonId":"py3.section.8743926740ea88241a956da7","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"输入 3 后执行 input 的结果加 1，会得到 4 吗？","result":"直接相加会类型不匹配。先用 int 转换有效数字文本。"},{"id":"py3.section.b21cdc6447c5998d2b4943b8.example","lessonId":"py3.section.b21cdc6447c5998d2b4943b8","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"把两个赋值压到一行再出现语法拒绝，怎样移植到平台？","result":"拆成两个逻辑行并保持原缩进与执行顺序。"},{"id":"py3.section.38ccf09bdb32fa5b69c405c3.example","lessonId":"py3.section.38ccf09bdb32fa5b69c405c3","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"删除 if 后第一条语句的缩进，错误发生在哪一层？","result":"解析阶段需要一个缩进代码块，此时无法组成合法语句。"},{"id":"py3.section.7a4575ac8e2b544d92079dc0.example","lessonId":"py3.section.7a4575ac8e2b544d92079dc0","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"print('甲','乙', sep='-') 的一行内容是什么？","result":"甲-乙，默认再写一个换行。"},{"id":"py3.section.0d8c4a7cb594796991dcce6b.example","lessonId":"py3.section.0d8c4a7cb594796991dcce6b","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"已经写 import math，访问平方根时用什么形式？","result":"完整 Python 中可使用 math.sqrt，名字 sqrt 本身不会被这条语句直接绑定。"},{"id":"py3.section.d681894cb19c2e1964ea2776.example","lessonId":"py3.section.d681894cb19c2e1964ea2776","status":"reading-only","reason":"本页同时讲解受限子集与完整 Python；只有映射中逐项标出的原创例子和练习获得本期运行承诺。","prompt":"执行脚本时在文件名后加 report.txt，input 会直接读到它吗？","result":"不会。参数由命令行接口读取，input 读取标准输入的下一行。"}],"activities":[{"id":"py3.section.be3a9f33f4919edf3584d13f.check","lessonId":"py3.section.be3a9f33f4919edf3584d13f","kind":"optional-self-check","exampleId":"py3.section.be3a9f33f4919edf3584d13f.example","prompt":"源文件保存为其他编码且包含中文，改变输出变量名会解决解析问题吗？","reveal":"不会。应核对实际文件编码与声明，本平台源码使用 UTF-8。"},{"id":"py3.section.7311ffeebcf2d9ac54125d9e.check","lessonId":"py3.section.7311ffeebcf2d9ac54125d9e","kind":"optional-self-check","exampleId":"py3.section.7311ffeebcf2d9ac54125d9e.example","prompt":"count 和 Count 会共享一个变量值吗？","reveal":"不会。它们是两个不同的名字。"},{"id":"py3.section.61a75b85dea545cf4e6320f1.check","lessonId":"py3.section.61a75b85dea545cf4e6320f1","kind":"optional-self-check","exampleId":"py3.section.61a75b85dea545cf4e6320f1.example","prompt":"想用 class 作变量名，改成 class_name 会改变什么？","reveal":"class_name 是可绑定的标识符，原先的 class 会被解析成关键字。"},{"id":"py3.section.8accf08638730e9fb677560c.check","lessonId":"py3.section.8accf08638730e9fb677560c","kind":"optional-self-check","exampleId":"py3.section.8accf08638730e9fb677560c.example","prompt":"print('编号#3') 里的井号会截断字符串吗？","reveal":"不会。它位于字符串内部，会原样输出。"},{"id":"py3.section.8a26d37c31e373f273321ff0.check","lessonId":"py3.section.8a26d37c31e373f273321ff0","kind":"optional-self-check","exampleId":"py3.section.8a26d37c31e373f273321ff0.example","prompt":"两行 print 只有第一行缩在 if 下，条件为假时会怎样？","reveal":"第一行跳过，第二行若回到外层仍会运行。"},{"id":"py3.section.6b8a553ad6fc175b5a12f742.check","lessonId":"py3.section.6b8a553ad6fc175b5a12f742","kind":"optional