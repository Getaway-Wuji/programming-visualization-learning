{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "packageRef", "learningAuthority", "cases"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "catalog.cpp.sieve-sequences"
    },
    "version": {
      "const": "1.0.0"
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "learningAuthority": {
      "const": false
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "programRef",
          "language",
          "engine",
          "sourceFile",
          "prerequisiteLessonRef",
          "knowledgeRefs",
          "arrays",
          "title",
          "topic",
          "inputKind",
          "statement",
          "platformConstraints",
          "defaults",
          "strategy",
          "explanation",
          "complexity",
          "derivation",
          "pitfalls",
          "reviewQuestion",
          "samples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "version": {
            "const": "1.0.0"
          },
          "programRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2200
              },
              "version": {
                "const": "1.0.0"
              }
            }
          },
          "language": {
            "const": "cpp"
          },
          "engine": {
            "const": "engine.rust.advanced"
          },
          "sourceFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "prerequisiteLessonRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2200
              },
              "version": {
                "const": "1.0.0"
              }
            }
          },
          "knowledgeRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                },
                "version": {
                  "const": "1.0.0"
                }
              }
            }
          },
          "arrays": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "label", "extent"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                },
                "extent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                }
              }
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "inputKind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "platformConstraints": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "defaults": {
            "type": "object",
            "additionalProperties": false,
            "required": ["values"],
            "properties": {
              "values": {
                "type": "array",
                "minItems": 0,
                "maxItems": 30,
                "items": {
                  "type": "integer",
                  "minimum": -999,
                  "maximum": 999
                }
              }
            }
          },
          "strategy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "explanation": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2200
            }
          },
          "complexity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "derivation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "pitfalls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2200
            }
          },
          "reviewQuestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          },
          "samples": {
            "type": "array",
            "minItems": 10,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "values", "expectedStdout", "expectedReturn"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                },
                "values": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 30,
                  "items": {
                    "type": "integer",
                    "minimum": -999,
                    "maximum": 999
                  }
                },
                "expectedStdout": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "expectedReturn": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
