{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "packageRef", "learningAuthority", "case"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "catalog.cpp.kmp"
    },
    "version": {
      "const": "1.0.0"
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "learningAuthority": {
      "const": false
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "programRef",
        "language",
        "engine",
        "sourceFile",
        "prerequisiteLessonRef",
        "knowledgeRefs",
        "title",
        "topic",
        "statement",
        "platformConstraints",
        "defaults",
        "strategy",
        "explanation",
        "complexity",
        "derivation",
        "pitfalls",
        "reviewQuestion",
        "samples"
      ],
      "properties": {
        "id": {
          "const": "case.cpp.kmp"
        },
        "version": {
          "const": "1.0.0"
        },
        "programRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "const": "program.cpp.kmp"
            },
            "version": {
              "const": "1.0.0"
            }
          }
        },
        "language": {
          "const": "cpp"
        },
        "engine": {
          "const": "engine.rust.advanced"
        },
        "sourceFile": {
          "const": "content/algorithms/cpp/kmp-1.0.0.cpp"
        },
        "prerequisiteLessonRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2200
            },
            "version": {
              "const": "1.0.0"
            }
          }
        },
        "knowledgeRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2200
              },
              "version": {
                "const": "1.0.0"
              }
            }
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "platformConstraints": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "pattern"],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[ -~]*$",
              "minLength": 0
            },
            "pattern": {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[ -~]*$",
              "minLength": 0
            }
          }
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "explanation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          }
        },
        "complexity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "derivation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "pitfalls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2200
          }
        },
        "reviewQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2200
        },
        "samples": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "text",
              "pattern",
              "expectedIndex",
              "expectedStdout",
              "expectedReturn"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2200
              },
              "text": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^[ -~]*$",
                "minLength": 0
              },
              "pattern": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^[ -~]*$",
                "minLength": 0
              },
              "expectedIndex": {
                "type": "integer",
                "minimum": -1,
                "maximum": 30
              },
              "expectedStdout": {
                "type": "string",
                "minLength": 2,
                "maxLength": 4
              },
              "expectedReturn": {
                "const": 0
              }
            }
          }
        }
      }
    }
  }
}
