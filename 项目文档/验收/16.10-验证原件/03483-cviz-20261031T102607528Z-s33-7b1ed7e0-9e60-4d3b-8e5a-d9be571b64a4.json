  "source": {
    "text": "#include <stdio.h>\nint factorial(int n) {\n    if (n <= 1) { return 1; }\n    int saved = n;\n    int child = factorial(n - 1);\n    return saved * child;\n}\nint change(int n) {\n    n = 99;\n    return n;\n}\nint main(void) {\n    int n = 5;\n    int changed = change(n);\n    int result = factorial(n);\n    printf(\"%d %d %d\\n\", n, changed, result);\n    return 0;\n}\n",
    "encoding": "UTF-8",
