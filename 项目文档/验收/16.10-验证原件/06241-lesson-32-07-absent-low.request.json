nd":440,"start":243}},{"blockId":"block.code.48","byteRange":{"end":446,"start":166}},{"blockId":"block.code.49","byteRange":{"end":472,"start":466}},{"blockId":"block.code.50","byteRange":{"end":474,"start":451}},{"blockId":"block.code.51","byteRange":{"end":487,"start":486}},{"blockId":"block.code.52","byteRange":{"end":488,"start":479}},{"blockId":"block.code.53","byteRange":{"end":490,"start":19}}],"text":"#include <stdio.h>\nint main(void) {\n    int n = 2;\n    int values[2] = {1, 3};\n    int target = -1;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"exercise.c.binary-search-first","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}