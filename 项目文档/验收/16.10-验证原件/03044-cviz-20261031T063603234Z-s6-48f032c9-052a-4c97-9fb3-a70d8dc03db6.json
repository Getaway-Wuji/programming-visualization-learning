  "source": {
    "text": "#include <stdio.h>\nint set(int* p, int value) {\n    *p = value;\n    return *p;\n}\nint main(void) {\n    int values[3] = {2, 4, 6};\n    int* p = &values[0];\n    p = p + 1;\n    set(p, 9);\n    printf(\"%d %d\\n\", values[1], *(p + 1));\n    return 0;\n}\n",
