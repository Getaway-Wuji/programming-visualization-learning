d":444,"start":247}},{"blockId":"block.code.48","byteRange":{"end":450,"start":170}},{"blockId":"block.code.49","byteRange":{"end":476,"start":470}},{"blockId":"block.code.50","byteRange":{"end":478,"start":455}},{"blockId":"block.code.51","byteRange":{"end":491,"start":490}},{"blockId":"block.code.52","byteRange":{"end":492,"start":483}},{"blockId":"block.code.53","byteRange":{"end":494,"start":19}}],"text":"#include <stdio.h>\nint main(void) {\n    int n = 3;\n    int values[3] = {-2, 0, 3};\n    int target = -2;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"exercise.c.binary-search-first","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}