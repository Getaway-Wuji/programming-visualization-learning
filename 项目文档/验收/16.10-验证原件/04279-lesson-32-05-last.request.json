:443,"start":246}},{"blockId":"block.code.48","byteRange":{"end":449,"start":169}},{"blockId":"block.code.49","byteRange":{"end":475,"start":469}},{"blockId":"block.code.50","byteRange":{"end":477,"start":454}},{"blockId":"block.code.51","byteRange":{"end":490,"start":489}},{"blockId":"block.code.52","byteRange":{"end":491,"start":482}},{"blockId":"block.code.53","byteRange":{"end":493,"start":19}}],"text":"#include <stdio.h>\nint main(void) {\n    int n = 3;\n    int values[3] = {-2, 0, 3};\n    int target = 3;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"exercise.c.binary-search-first","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}