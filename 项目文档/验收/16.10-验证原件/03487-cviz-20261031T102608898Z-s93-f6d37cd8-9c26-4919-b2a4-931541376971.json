  "source": {
    "text": "#include <iostream>\nvoid hanoi(int n, int from, int to, int spare) {\n    if (n <= 0) { return; }\n    hanoi(n - 1, from, spare, to);\n    std::cout << from << \"->\" << to << \"\\n\";\n    hanoi(n - 1, spare, to, from);\n}\nint main() {\n    int n;\n    std::cin >> n;\n    hanoi(n, 1, 3, 2);\n    return 0;\n}\n",
