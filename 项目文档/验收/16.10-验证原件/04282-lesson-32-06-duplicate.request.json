e":{"end":449,"start":252}},{"blockId":"block.code.48","byteRange":{"end":455,"start":175}},{"blockId":"block.code.49","byteRange":{"end":481,"start":475}},{"blockId":"block.code.50","byteRange":{"end":483,"start":460}},{"blockId":"block.code.51","byteRange":{"end":496,"start":495}},{"blockId":"block.code.52","byteRange":{"end":497,"start":488}},{"blockId":"block.code.53","byteRange":{"end":499,"start":19}}],"text":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int values[5] = {-2, 0, 0, 0, 3};\n    int target = 0;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"exercise.c.binary-search-first","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}