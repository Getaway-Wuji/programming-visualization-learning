nd":439,"start":242}},{"blockId":"block.code.48","byteRange":{"end":445,"start":165}},{"blockId":"block.code.49","byteRange":{"end":471,"start":465}},{"blockId":"block.code.50","byteRange":{"end":473,"start":450}},{"blockId":"block.code.51","byteRange":{"end":486,"start":485}},{"blockId":"block.code.52","byteRange":{"end":487,"start":478}},{"blockId":"block.code.53","byteRange":{"end":489,"start":19}}],"text":"#include <stdio.h>\nint main(void) {\n    int n = 2;\n    int values[2] = {1, 3};\n    int target = 4;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"exercise.c.binary-search-first","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}