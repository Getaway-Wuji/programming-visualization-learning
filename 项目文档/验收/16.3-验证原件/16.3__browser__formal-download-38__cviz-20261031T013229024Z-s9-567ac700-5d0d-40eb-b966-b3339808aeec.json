  "source": {
    "text": "#include <iostream>\nstruct Node {\n    int value;\n    Node* next;\n};\nNode* make(int value, Node* next) {\n    Node* node = new Node{};\n    node->value = value;\n    node->next = next;\n    return node;\n}\nvoid print(Node* head) {\n    for (Node* p = head; p != nullptr; p = p->next) {\n        std::cout << p->value << \" \";\n    }\n    std::cout << \"\\n\";\n}\nint main() {\n    int a;\n    int b;\n    int c;\n    std::cin >> a >> b >> c;\n    Node* tail = make(c, nullptr);\n    Node* middle = make(b, tail);\n    Node* head = make(a, middle);\n    print(head);\n    head->next = tail;\n    delete middle;\n    print(head);\n    delete head;\n    delete tail;\n    return 0;\n}\n",
