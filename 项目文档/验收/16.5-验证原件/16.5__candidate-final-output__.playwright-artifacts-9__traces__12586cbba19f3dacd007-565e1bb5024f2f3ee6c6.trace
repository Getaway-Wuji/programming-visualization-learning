phase gap\n    for (int gap = n / 2; gap > 0; gap = gap / 2) {\n        // @phase insert\n        for (int i = gap; i < n; i = i + 1) {\n            int key = values[i];\n            int j = i;\n            // @phase shift\n            while (j >= gap && values[j - gap] > key) {\n                values[j] = values[j - gap];\n                j = j - gap;\n            }\n            // @phase place\n            values[j] = key;\n        }\n    }\n    // @phase output\n    for (int i = 0; i < n; i = i + 1) {\n        std::cout << values[i] << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n","aria-label":"可复制的完整C++源码","readonly":"","rows":"8","spellcheck":"false"},"#include <iostream>\n// @phase setup\nint main() {\n    int n = 6;\n    int values[30] = {};\n    // @phase input\n    for (int i = 0; i < n; i = i + 1) {\n        std::cin >> values[i];\n    }\n    // @phase gap\n    for (int gap = n / 2; gap > 0; gap = gap / 2) {\n        // @phase insert\n        for (int i = gap; i < n; i = i + 1) {\n            int key = values[i];\n            int j = i;\n            // @phase shift\n            while (j >= gap && values[j - gap] > key) {\n                values[j] = values[j - gap];\n                j = j - gap;\n            }\n            // @phase place\n            values[j] = key;\n        }\n    }\n    // @phase output\n    for (int i = 0; i < n; i = i + 1) {\n        std::cout << values[i] << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n"]]]]],[[9,80]],[[9,137]]]],[[9,171]],[[9,184]]]]]]],[[11,134]]]],"viewport":{"width":1440,"height":900},"timestamp":32360.029,"wallTime":1793415210899,"collectionTime":0.4000000059604645,"resourceOverrides":[],"isMainFrame":true}}
