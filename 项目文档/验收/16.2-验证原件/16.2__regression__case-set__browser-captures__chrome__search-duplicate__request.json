{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"61cd6a73-dc88-49ee-b261-4d4085a5c7fe","contextRevision":1,"runId":"5af7396b-5ad8-42f8-b13f-fbafcf06e2fe","sourceRevision":1,"submissionId":"868f1af3-6d31-40b7-af00-159037f9edbf","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.sorted-search","version":"1.0.0"},"values":{"target":0,"values":[-2,0,0,4,8]}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.binary-search-first","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":972,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}},{"bindingKey":"param.values","byteRange":{"end":88,"start":55}},{"bindingKey":"param.target","byteRange":{"end":108,"start":93}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int values[5] = {-2, 0, 0, 4, 8};\n    int target = 0;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.binary-search-first","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}