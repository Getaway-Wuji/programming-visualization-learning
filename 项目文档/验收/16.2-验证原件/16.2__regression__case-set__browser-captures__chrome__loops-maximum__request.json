{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"6f08611c-85c4-480d-bc34-fce7cbec9558","contextRevision":2,"runId":"06ee6793-8420-4215-bd2d-b2ffaad5e575","sourceRevision":2,"submissionId":"e44c11c9-06fa-4140-a585-3d81a2dcdeb7","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.loop-count","version":"1.0.0"},"values":{"n":30}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.two-loop-sums","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":970,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":51,"start":40}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 30;\n    int i = 1;\n    int sumWhile = 0;\n    while (i <= n) {\n        sumWhile = sumWhile + i;\n        i = i + 1;\n    }\n    int sumFor = 0;\n    for (int j = 1; j <= n; j = j + 1) {\n        sumFor = sumFor + j;\n    }\n    printf(\"%d\\n%d\\n\", sumWhile, sumFor);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.loops","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}