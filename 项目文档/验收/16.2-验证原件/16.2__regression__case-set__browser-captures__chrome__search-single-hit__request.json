{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"faeecf92-570b-44f5-a508-b40b306c98f4","contextRevision":3,"runId":"02bbe2b7-4f95-4d96-8a3b-7233445fd75b","sourceRevision":3,"submissionId":"0da5655f-e745-46e5-ad4f-c5b318e65a1d","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.sorted-search","version":"1.0.0"},"values":{"target":-4,"values":[-4]}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.binary-search-first","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":971,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}},{"bindingKey":"param.values","byteRange":{"end":76,"start":55}},{"bindingKey":"param.target","byteRange":{"end":97,"start":81}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 1;\n    int values[1] = {-4};\n    int target = -4;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.binary-search-first","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}