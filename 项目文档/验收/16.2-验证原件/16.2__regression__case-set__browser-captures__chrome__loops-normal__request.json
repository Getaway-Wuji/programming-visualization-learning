{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"92773534-b5e6-4954-ae7b-f9bdf6e2a4eb","contextRevision":1,"runId":"ec63bac3-8c52-460e-ae2f-25fdd0a5935c","sourceRevision":1,"submissionId":"94a0765f-2e4b-4969-b092-72656a686ce9","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.loop-count","version":"1.0.0"},"values":{"n":5}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.two-loop-sums","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":971,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int i = 1;\n    int sumWhile = 0;\n    while (i <= n) {\n        sumWhile = sumWhile + i;\n        i = i + 1;\n    }\n    int sumFor = 0;\n    for (int j = 1; j <= n; j = j + 1) {\n        sumFor = sumFor + j;\n    }\n    printf(\"%d\\n%d\\n\", sumWhile, sumFor);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.loops","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}