{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"484bdfb2-bdfd-42db-93a9-f1681076d923","contextRevision":2,"runId":"74c06018-1a98-4656-ab60-beae6955f7e7","sourceRevision":2,"submissionId":"9b0e21b6-e32a-4e61-b567-2429cb39af0b","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.sorted-search","version":"1.0.0"},"values":{"target":0,"values":[-4]}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.binary-search-first","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":971,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}},{"bindingKey":"param.values","byteRange":{"end":76,"start":55}},{"bindingKey":"param.target","byteRange":{"end":96,"start":81}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 1;\n    int values[1] = {-4};\n    int target = 0;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.binary-search-first","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}