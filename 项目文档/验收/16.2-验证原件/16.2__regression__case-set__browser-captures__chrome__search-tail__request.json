{"budgetRef":{"id":"budget.p0","version":"1.0.0"},"diagnosticVersion":"1.0.0","encodingVersion":"1.0.0","engineRef":{"buildId":"aed203f4fe30ccaafdb32d0c68c2a1f2634c10726c82977684d4e3d20228679d","id":"engine.c.p0","version":"1.0.0"},"identity":{"contextId":"d827d368-4776-45aa-bb3f-c021fbc3e61e","contextRevision":2,"runId":"4038684e-1b2d-4964-9b04-13834c567425","sourceRevision":2,"submissionId":"a8a79fe6-86c9-4a00-9305-aaf8d4572d69","testCaseKey":null},"input":{"random":null,"specRef":{"id":"input.c.sorted-search","version":"1.0.0"},"values":{"target":8,"values":[-2,0,0,4,8]}},"judge":null,"judgeVersion":"1.0.0","kind":"execute","languageRef":{"id":"lang.c","version":"1.0.0"},"learningRevision":1,"mode":"case","packageRef":{"id":"content.c.p05","version":"1.0.0"},"programRef":{"id":"program.c.binary-search-first","version":"1.0.0"},"protocolVersion":"1.0.0","remainingMs":973,"source":{"bindingMap":[{"bindingKey":"param.n","byteRange":{"end":50,"start":40}},{"bindingKey":"param.values","byteRange":{"end":88,"start":55}},{"bindingKey":"param.target","byteRange":{"end":108,"start":93}}],"blockMap":[],"text":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int values[5] = {-2, 0, 0, 4, 8};\n    int target = 8;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n"},"subjectRef":{"id":"case.c.binary-search-first","version":"1.1.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"traceVersion":"1.0.0"}