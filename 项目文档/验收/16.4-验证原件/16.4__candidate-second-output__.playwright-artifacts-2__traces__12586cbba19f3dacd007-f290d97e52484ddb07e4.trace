{"type":"before","callId":"veof@180","startTime":67425.898,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n    const db = await new Promise((resolve, reject) => {\n      const req = indexedDB.open('c-viz-learning');\n      req.onsuccess = () => resolve(req.result);\n      req.onerror = () => reject(req.error);\n    });\n    try {\n      const names = Array.from(db.objectStoreNames);\n      const tx = db.transaction(names, 'readonly');\n      const done = new Promise((resolve, reject) => {\n        tx.oncomplete = () => resolve();\n        tx.onabort = () => reject(tx.error);\n      });\n      const entries = await Promise.all(names.map(async name => [name, await new Promise((resolve, reject) => {\n        const store = tx.objectStore(name);\n        const req = ['meta', 'settings', 'avatar', 'appearance'].includes(name) ? store.get('current') : store.getAll();\n        req.onsuccess = () => resolve(req.result);\n        req.onerror = () => reject(req.error);\n      })]));\n      await done;\n      return Object.fromEntries(entries);\n    } finally {\n      db.close();\n    }\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
