    while (j >= 0 && values[j] > key) {\n            values[j + 1] = values[j];\n            j = j - 1;\n        }\n        // @phase place\n        values[j + 1] = key;\n    }\n    // @phase output\n    for (int i = 0; i < n; i = i + 1) {\n        std::cout << values[i] << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n","aria-label":"可复制的完整C++源码","readonly":"","rows":"8","spellcheck":"false"},"#include <iostream>\n// @phase setup\nint main() {\n    int n = 1;\n    int values[30] = {};\n    // @phase input\n    for (int i = 0; i < n; i = i + 1) {\n        std::cin >> values[i];\n    }\n    // @phase insert\n    for (int i = 1; i < n; i = i + 1) {\n        int key = values[i];\n        int j = i - 1;\n        // @phase shift\n        while (j >= 0 && values[j] > key) {\n            values[j + 1] = values[j];\n            j = j - 1;\n        }\n        // @phase place\n        values[j + 1] = key;\n    }\n    // @phase output\n    for (int i = 0; i < n; i = i + 1) {\n        std::cout << values[i] << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n"]]]]],[[9,88]],[[9,145]]]],[[9,165]],[[9,174]]]]]]],[[11,133]]]],"viewport":{"width":1440,"height":900},"timestamp":67446.177,"wallTime":1793411947712,"collectionTime":0.3999999761581421,"resourceOverrides":[],"isMainFrame":true}}
