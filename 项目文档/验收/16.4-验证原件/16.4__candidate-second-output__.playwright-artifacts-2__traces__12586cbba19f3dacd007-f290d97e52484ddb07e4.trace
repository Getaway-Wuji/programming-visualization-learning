{"type":"before","callId":"veof@199","startTime":67561.786,"title":"Expect \"toHaveText\"","class":"Frame","method":"expect","params":{"selector":"internal:testid=[data-testid=\"sort-source\"s]","expression":"to.have.text","expectedText":[{"string":"#include <iostream>\n// @phase setup\nint main() {\n    int n = 1;\n    int values[30] = {};\n    // @phase input\n    for (int i = 0; i < n; i = i + 1) {\n        std::cin >> values[i];\n    }\n    // @phase insert\n    for (int i = 1; i < n; i = i + 1) {\n        int key = values[i];\n        int j = i - 1;\n        // @phase shift\n        while (j >= 0 && values[j] > key) {\n            values[j + 1] = values[j];\n            j = j - 1;\n        }\n        // @phase place\n        values[j + 1] = key;\n    }\n    // @phase output\n    for (int i = 0; i < n; i = i + 1) {\n        std::cout << values[i] << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n","normalizeWhiteSpace":true}],"expectedValue":{"value":{"v":"undefined"},"handles":[]},"isNot":false,"timeout":5000}}
