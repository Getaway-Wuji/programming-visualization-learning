    {
      "id":"program.c.selection-sort","version":"1.0.0","title":"选择排序参考","languageRef":{"id":"lang.c","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"inputRef":{"id":"input.c.int-sequence","version":"1.0.0"},"exampleInput":{"values":[3,1,2]},
      "sourceExample":"#include <stdio.h>\nint main(void) {\n    int n = 3;\n    int values[3] = {3, 1, 2};\n    for (int i = 0; i < n - 1; i = i + 1) {\n        int minIndex = i;\n        for (int j = i + 1; j < n; j = j + 1) {\n            if (values[j] < values[minIndex]) {\n                minIndex = j;\n            }\n        }\n        if (minIndex != i) {\n            int temp = values[i];\n            values[i] = values[minIndex];\n            values[minIndex] = temp;\n        }\n    }\n    for (int k = 0; k < n; k = k + 1) {\n        if (k > 0) {\n            printf(\" \");\n        }\n        printf(\"%d\", values[k]);\n    }\n    printf(\"\\n\");\n    return 0;\n}\n",
      "bindings":[{"bindingKey":"param.n","inputKey":"values","targetName":"n","targetKind":"logical-length","from":"length-of"},{"bindingKey":"param.values","inputKey":"values","targetName":"values","targetKind":"array","from":"field","emptyStorage":"one-zero-placeholder"}],
      "blockRefs":[{"id":"block.c.main","version":"1.0.0"},{"id":"block.c.integer","version":"1.0.0"},{"id":"block.c.declare-int","version":"1.0.0"},{"id":"block.c.read-variable","version":"1.0.0"},{"id":"block.c.assign-variable","version":"1.0.0"},{"id":"block.c.arithmetic","version":"1.0.0"},{"id":"block.c.comparison","version":"1.0.0"},{"id":"block.c.if","version":"1.0.0"},{"id":"block.c.for","version":"1.0.0"},{"id":"block.c.declare-array","version":"1.0.0"},{"id":"block.c.read-array","version":"1.0.0"},{"id":"block.c.write-array","version":"1.0.0"},{"id":"block.c.printf","version":"1.0.0"},{"id":"block.c.return","version":"1.0.0"}],"reference":{"document":"../架构决策/01.3-正反样例清单.md","locator":"REF-09"}
    },
    {
      "id":"program.c.binary-search-first","version":"1.0.0","title":"首次匹配二分参考","languageRef":{"id":"lang.c","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"inputRef":{"id":"input.c.sorted-search","version":"1.0.0"},"exampleInput":{"values":[-2,0,0,4,8],"target":0},
      "sourceExample":"#include <stdio.h>\nint main(void) {\n    int n = 5;\n    int values[5] = {-2, 0, 0, 4, 8};\n    int target = 0;\n    int left = 0;\n    int right = n - 1;\n    int answer = -1;\n    while (left <= right) {\n        int mid = left + (right - left) / 2;\n        if (values[mid] >= target) {\n            if (values[mid] == target) {\n                answer = mid;\n            }\n            right = mid - 1;\n        } else {\n            left = mid + 1;\n        }\n    }\n    printf(\"%d\\n\", answer);\n    return 0;\n}\n",
      "bindings":[{"bindingKey":"param.n","inputKey":"values","targetName":"n","targetKind":"logical-length","from":"length-of"},{"bindingKey":"param.values","inputKey":"values","targetName":"values","targetKind":"array","from":"field","emptyStorage":"one-zero-placeholder"},{"bindingKey":"param.target","inputKey":"target","targetName":"target","targetKind":"scalar","from":"field"}],
      "blockRefs":[{"id":"block.c.main","version":"1.0.0"},{"id":"block.c.integer","version":"1.0.0"},{"id":"block.c.declare-int","version":"1.0.0"},{"id":"block.c.read-variable","version":"1.0.0"},{"id":"block.c.assign-variable","version":"1.0.0"},{"id":"block.c.arithmetic","version":"1.0.0"},{"id":"block.c.comparison","version":"1.0.0"},{"id":"block.c.if","version":"1.0.0"},{"id":"block.c.while","version":"1.0.0"},{"id":"block.c.declare-array","version":"1.0.0"},{"id":"block.c.read-array","version":"1.0.0"},{"id":"block.c.printf","version":"1.0.0"},{"id":"block.c.return","version":"1.0.0"},{"id":"block.c.unary","version":"1.0.0"}],"reference":{"document":"../架构决策/01.3-正反样例清单.md","locator":"REF-10"}
