    {
      "id":"program.c.bubble-sort","version":"1.0.0","title":"冒泡排序参考","languageRef":{"id":"lang.c","version":"1.0.0"},"subsetRef":{"id":"subset.c.p0","version":"1.0.0"},"inputRef":{"id":"input.c.int-sequence","version":"1.0.0"},"exampleInput":{"values":[3,1,2]},
      "sourceExample":"#include <stdio.h>\nint main(void) {\n    int n = 3;\n    int values[3] = {3, 1, 2};\n    for (int end = n - 1; end > 0; end = end - 1) {\n        for (int j = 0; j < end; j = j + 1) {\n            if (values[j] > values[j + 1]) {\n                int temp = values[j];\n                values[j] = values[j + 1];\n                values[j + 1] = temp;\n            }\n        }\n    }\n    for (int i = 0; i < n; i = i + 1) {\n        if (i > 0) {\n            printf(\" \");\n        }\n        printf(\"%d\", values[i]);\n    }\n    printf(\"\\n\");\n    return 0;\n}\n",
      "bindings":[{"bindingKey":"param.n","inputKey":"values","targetName":"n","targetKind":"logical-length","from":"length-of"},{"bindingKey":"param.values","inputKey":"values","targetName":"values","targetKind":"array","from":"field","emptyStorage":"one-zero-placeholder"}],
      "blockRefs":[{"id":"block.c.main","version":"1.0.0"},{"id":"block.c.integer","version":"1.0.0"},{"id":"block.c.declare-int","version":"1.0.0"},{"id":"block.c.read-variable","version":"1.0.0"},{"id":"block.c.assign-variable","version":"1.0.0"},{"id":"block.c.arithmetic","version":"1.0.0"},{"id":"block.c.comparison","version":"1.0.0"},{"id":"block.c.if","version":"1.0.0"},{"id":"block.c.for","version":"1.0.0"},{"id":"block.c.declare-array","version":"1.0.0"},{"id":"block.c.read-array","version":"1.0.0"},{"id":"block.c.write-array","version":"1.0.0"},{"id":"block.c.printf","version":"1.0.0"},{"id":"block.c.return","version":"1.0.0"}],"reference":{"document":"../架构决策/01.3-正反样例清单.md","locator":"REF-08"}
