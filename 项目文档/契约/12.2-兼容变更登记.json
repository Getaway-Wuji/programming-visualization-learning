    {
      "contractId": "EXEC-01",
      "path": "/$defs/request",
      "change": "Explicit engine.rust.memory / C or C++ request, immutable source and independent execute_memory boundary."
    },
    {
      "contractId": "EXEC-01",
      "path": "/$defs/result/types",
      "change": "Closed immutable scalar/pointer/struct layout table; no host ABI or addresses."
    },
    {
      "contractId": "STEP-01",
      "path": "/trace/initialState/objects",
      "change": "Typed automatic/heap objects, alive tombstones, bounded object IDs/offset pointers and sparse typed slots."
    },
    {
      "contractId": "STEP-01",
      "path": "/trace/steps",
      "change": "Reversible memory.allocate/release and pointer.write, tagged pointer return values and byte-offset cell changes."
    },
    {
      "contractId": "DIAG-01",
      "path": "/terminal",
      "change": "Null/uninitialized/dangling/bounds/type and invalid/double delete diagnostics with real source ranges."
    },
    {
      "contractId": "DEC-P1-002",
      "path": "bounded-memory",
      "change": "Structs8/fields8, cumulative objects4096/live heap128, original ceilings; C++ single-object new/delete; all unsupported dynamic C and C++ syntax rejected."
    }
  ],
