{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-01:1.0.0",
  "title": "CONTENT-01 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "packageId", "packageVersion", "purpose", "phase", "languages", "subsets", "chapters", "lessons", "knowledgePoints", "inputSpecs", "programs", "judgeProfiles", "exercises", "cases", "blocks", "rewardSources"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "packageId": {"$ref": "#/$defs/id"},
    "packageVersion": {"$ref": "#/$defs/version"},
    "purpose": {"enum": ["contract-fixture", "publishable"]},
    "phase": {"const": "P0"},
    "languages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/language"}},
    "subsets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subset"}},
    "chapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "lessons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lesson"}},
    "knowledgePoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledge"}},
    "inputSpecs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputSpec"}},
    "programs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/program"}},
    "judgeProfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/judge"}},
    "exercises": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exercise"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
    "rewardSources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reward"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}}
    },
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "nonemptyRefs": {"allOf": [{"$ref": "#/$defs/refs"}], "minItems": 1},
    "base": {
      "type": "object", "required": ["id", "version", "title"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "title": {"$ref": "#/$defs/text"}}
    },
    "languageBase": {
      "allOf": [{"$ref": "#/$defs/base"}], "required": ["languageRef"],
      "properties": {"languageRef": {"$ref": "#/$defs/ref"}}
    },
    "learningBase": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "required": ["learningRevision", "acceptedPriorVersions"],
      "properties": {
        "learningRevision": {"type": "integer", "minimum": 1},
        "acceptedPriorVersions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/version"}}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["document", "locator"],
      "properties": {"document": {"$ref": "#/$defs/text"}, "locator": {"$ref": "#/$defs/text"}}
    },
    "teaching": {
      "type": "object", "additionalProperties": false,
      "required": ["objectives", "explanation", "exampleProgramRefs", "commonMistakes", "boundaryNotes", "source"],
      "properties": {
        "objectives": {"$ref": "#/$defs/texts"}, "explanation": {"$ref": "#/$defs/text"},
        "exampleProgramRefs": {"$ref": "#/$defs/nonemptyRefs"},
        "commonMistakes": {"$ref": "#/$defs/texts"}, "boundaryNotes": {"$ref": "#/$defs/texts"}, "source": {"$ref": "#/$defs/reference"}
      }
    },
    "language": {
      "allOf": [{"$ref": "#/$defs/base"}], "unevaluatedProperties": false,
      "required": ["execution", "subsetRefs"],
      "properties": {"execution": {"enum": ["subset", "reserved"]}, "subsetRefs": {"$ref": "#/$defs/refs"}}
    },
    "subset": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "unevaluatedProperties": false,
      "required": ["decision", "capabilityIds"],
      "properties": {"decision": {"const": "P0-C V1.0"}, "capabilityIds": {"$ref": "#/$defs/capabilities"}}
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c\\.p0\\.(0[1-9]|1[0-9]|20)$"}},
    "chapter": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "unevaluatedProperties": false,
      "required": ["order", "lessonRefs"],
      "properties": {"order": {"type": "integer", "minimum": 1}, "lessonRefs": {"$ref": "#/$defs/nonemptyRefs"}}
    },
    "lesson": {
      "allOf": [{"$ref": "#/$defs/learningBase"}], "unevaluatedProperties": false,
      "required": ["chapterRef", "knowledgeRefs", "requiredExerciseRefs", "optionalExerciseRefs", "caseRefs", "blockRefs", "teaching", "rewardRef"],
      "properties": {
        "chapterRef": {"$ref": "#/$defs/ref"}, "knowledgeRefs": {"$ref": "#/$defs/nonemptyRefs"},
        "requiredExerciseRefs": {"$ref": "#/$defs/nonemptyRefs"}, "optionalExerciseRefs": {"$ref": "#/$defs/refs"},
        "caseRefs": {"$ref": "#/$defs/refs"}, "blockRefs": {"$ref": "#/$defs/nonemptyRefs"}, "teaching": {"$ref": "#/$defs/teaching"}, "rewardRef": {"$ref": "#/$defs/ref"}
      }
    },
    "knowledge": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "unevaluatedProperties": false,
      "required": ["prerequisiteRefs"], "properties": {"prerequisiteRefs": {"$ref": "#/$defs/refs"}}
    },
    "inputSpec": {
      "allOf": [{"$ref": "#/$defs/base"}], "unevaluatedProperties": false,
      "required": ["fields", "relations"],
      "properties": {
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputField"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "inputField": {
      "type": "object", "additionalProperties": false, "required": ["key", "kind", "min", "max"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"}, "kind": {"enum": ["integer", "sequence"]},
        "min": {"type": "integer", "minimum": -999, "maximum": 999}, "max": {"type": "integer", "minimum": -999, "maximum": 999},
        "minItems": {"type": "integer", "minimum": 0, "maximum": 30}, "maxItems": {"type": "integer", "minimum": 0, "maximum": 30}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "sequence"}}}, "then": {"required": ["minItems", "maxItems"]}, "else": {"not": {"anyOf": [{"required": ["minItems"]}, {"required": ["maxItems"]}]}}}
      ]
    },
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["kind", "field"],
      "properties": {"kind": {"enum": ["length-of", "index-in", "nondecreasing"]}, "field": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"}},
      "allOf": [{"if": {"properties": {"kind": {"enum": ["length-of", "index-in"]}}}, "then": {"required": ["target"]}, "else": {"not": {"required": ["target"]}}}]
    },
    "inputValues": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}}]}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["bindingKey", "inputKey", "targetName", "targetKind", "from"],
      "properties": {
        "bindingKey": {"$ref": "#/$defs/id"}, "inputKey": {"$ref": "#/$defs/text"},
        "targetName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "targetKind": {"enum": ["scalar", "array", "logical-length"]}, "from": {"enum": ["field", "length-of"]},
        "emptyStorage": {"const": "one-zero-placeholder"}
      },
      "allOf": [{"if": {"properties": {"targetKind": {"const": "array"}}}, "then": {"required": ["emptyStorage"]}, "else": {"not": {"required": ["emptyStorage"]}}}]
    },
    "program": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "unevaluatedProperties": false,
      "required": ["subsetRef", "inputRef", "exampleInput", "sourceExample", "bindings", "blockRefs", "reference"],
      "properties": {
        "subsetRef": {"$ref": "#/$defs/ref"}, "inputRef": {"$ref": "#/$defs/ref"}, "exampleInput": {"$ref": "#/$defs/inputValues"},
        "sourceExample": {"$ref": "#/$defs/text"}, "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "blockRefs": {"$ref": "#/$defs/nonemptyRefs"}, "reference": {"$ref": "#/$defs/reference"}
      }
    },
    "judge": {
      "allOf": [{"$ref": "#/$defs/base"}], "unevaluatedProperties": false,
      "required": ["rule", "targetDescription"],
      "properties": {
        "rule": {"enum": ["input-read-output", "multiply-add-output", "if-else-paths", "while-for-accumulations", "single-index-increment", "logical-array-accumulation"]},
        "targetDescription": {"$ref": "#/$defs/text"}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false, "required": ["caseKey", "input", "expectedStdout", "expectedExitCode"],
      "properties": {
        "caseKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "input": {"$ref": "#/$defs/inputValues"},
        "expectedStdout": {"type": "string"}, "expectedExitCode": {"const": 0},
        "expectedArray": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}
      }
    },
    "exercise": {
      "allOf": [{"$ref": "#/$defs/learningBase"}], "unevaluatedProperties": false,
      "required": ["lessonRef", "knowledgeRefs", "programRef", "judgeRef", "prompt", "tests", "rewardRef"],
      "properties": {
        "lessonRef": {"$ref": "#/$defs/ref"}, "knowledgeRefs": {"$ref": "#/$defs/nonemptyRefs"}, "programRef": {"$ref": "#/$defs/ref"},
        "judgeRef": {"$ref": "#/$defs/ref"}, "prompt": {"$ref": "#/$defs/text"},
        "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}}, "rewardRef": {"$ref": "#/$defs/ref"}
      }
    },
    "case": {
      "allOf": [{"$ref": "#/$defs/learningBase"}], "unevaluatedProperties": false,
      "required": ["kind", "knowledgeRefs", "relatedLessonRefs", "programRef", "teaching", "resultRule", "rewardRef"],
      "properties": {
        "kind": {"enum": ["demo", "algorithm"]}, "knowledgeRefs": {"$ref": "#/$defs/nonemptyRefs"}, "relatedLessonRefs": {"$ref": "#/$defs/nonemptyRefs"},
        "programRef": {"$ref": "#/$defs/ref"}, "teaching": {"$ref": "#/$defs/teaching"},
        "resultRule": {"enum": ["assignment-add-two", "nonnegative-branch", "two-loop-sums", "logical-array-sum", "bubble-ascending", "selection-ascending", "binary-first-index"]},
        "rewardRef": {"$ref": "#/$defs/ref"}
      }
    },
    "block": {
      "allOf": [{"$ref": "#/$defs/languageBase"}], "unevaluatedProperties": false,
      "required": ["subsetRef", "connectionType", "slotTypes", "operators", "capabilityIds"],
      "properties": {
        "subsetRef": {"$ref": "#/$defs/ref"},
        "connectionType": {"enum": ["program", "statement", "int-expression"]},
        "slotTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["statement", "int-expression", "statement-list", "for-init", "for-update", "literal-list"]}},
        "operators": {"type": "array", "uniqueItems": true, "items": {"enum": ["+", "-", "!", "*", "/", "%", "<", "<=", ">", ">=", "==", "!=", "&&", "||"]}},
        "capabilityIds": {"$ref": "#/$defs/capabilities"}
      }
    },
    "reward": {
      "allOf": [{"$ref": "#/$defs/base"}], "unevaluatedProperties": false,
      "required": ["eventType", "scope", "repeat", "pointsOwner"],
      "properties": {
        "eventType": {"enum": ["exercise.passed", "lesson.completed", "case.view-confirmed", "daily-goal.achieved"]},
        "scope": {"enum": ["content-id", "local-day"]}, "repeat": {"enum": ["first-only", "once-per-day"]}, "pointsOwner": {"const": "11.1"}
      }
    }
  }
}
