{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c-viz:achievement:2.0.0",
  "title": "Current-generation achievements2, exact new catalog",
  "$comment": "Three badges, unchanged quotas, no points or course completion. Old achievement1 remains separate. Runtime validates evidence uniqueness, current generation, exact saved receipts and full completion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "achievementVersion",
        "generation",
        "revision",
        "catalogRef",
        "badgeRef",
        "packageRef",
        "unlockedAt",
        "evidence"
      ],
      "properties": {
        "achievementVersion": {
          "const": "2.0.0"
        },
        "generation": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "catalogRef": {
          "const": {
            "id": "achievement.catalog.local",
            "version": "2.0.0"
          }
        },
        "badgeRef": {
          "const": {
            "id": "badge.c6.array-initialization-pass",
            "version": "2.0.0"
          }
        },
        "packageRef": {
          "const": {
            "id": "content.c.primer6",
            "version": "2.0.0"
          }
        },
        "unlockedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/utcTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "eventId",
                  "subjectRef",
                  "learningRevision",
                  "occurredAt"
                ],
                "properties": {
                  "kind": {
                    "const": "exercise"
                  },
                  "eventId": {
                    "$ref": "#/$defs/uuid"
                  },
                  "subjectRef": {
                    "const": {
                      "id": "exercise.c6.s10.1.1",
                      "version": "2.0.0"
                    }
                  },
                  "learningRevision": {
                    "const": 1
                  },
                  "occurredAt": {
                    "$ref": "#/$defs/utcTime"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    {
