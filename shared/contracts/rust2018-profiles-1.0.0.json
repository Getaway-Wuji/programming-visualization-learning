    "title": "返回值与递归",
    "source": "fn factorial(value: i32) -> i32 {\n    if value <= 1 { 1 } else { value * factorial(value - 1) }\n}\nfn main() {\n    let mut line = String::new();\n    std::io::stdin().read_line(&mut line).unwrap();\n    let n: i32 = line.trim().parse().unwrap();\n    println!(\"{}\", factorial(n));\n}\n",
    "cases": [
      {
        "input": "0\n",
        "expected": "1\n",
        "requiredFeatures": [
          "call"
        ]
      },
      {
        "input": "1\n",
        "expected": "1\n",
        "requiredFeatures": [
          "call"
        ]
      },
      {
        "input": "4\n",
        "expected": "24\n",
        "requiredFeatures": [
          "call",
          "recursion"
        ]
      },
      {
        "input": "6\n",
        "expected": "720\n",
        "requiredFeatures": [
          "call",
          "recursion"
        ]
      }
    ],
    "requiredFeatures": [
      "call"
    ]
  },
