    "title": "调用中的可变借用",
    "source": "fn bump(value: &mut i32) { *value = *value + 2; }\nfn main() {\n    let mut line = String::new();\n    std::io::stdin().read_line(&mut line).unwrap();\n    let n: i32 = line.trim().parse().unwrap();\n    let mut value = n;\n    bump(&mut value);\n    println!(\"{}\", value);\n}\n",
    "cases": [
      {
        "input": "0\n",
        "expected": "2\n",
        "requiredFeatures": [
          "user-mutable-borrow"
