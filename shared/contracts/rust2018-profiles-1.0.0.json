    "source": "fn main() {\n    let mut line = String::new();\n    std::io::stdin().read_line(&mut line).unwrap();\n    let n: i32 = line.trim().parse().unwrap();\n    let mut total = 0;\n    for value in 0..=n { total = total + value; }\n    println!(\"{}\", total);\n}\n",
