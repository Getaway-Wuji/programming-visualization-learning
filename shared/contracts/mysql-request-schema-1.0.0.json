{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:c-viz:mysql:request:1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "language",
        "dialect",
        "runId",
        "sourceRevision",
        "source",
        "operation",
        "session"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "language": {
          "const": "mysql"
        },
        "dialect": {
          "const": "8.0"
        },
        "runId": {
          "$ref": "#/$defs/Opaque"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Opaque"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "operation": {
          "const": "execute"
        },
        "session": {
          "$ref": "#/$defs/Session"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "language",
        "dialect",
        "runId",
        "sourceRevision",
        "source",
        "operation",
        "profile",
        "reviewCase"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "language": {
          "const": "mysql"
        },
        "dialect": {
          "const": "8.0"
        },
        "runId": {
          "$ref": "#/$defs/Opaque"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Opaque"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "operation": {
          "const": "judge"
        },
        "profile": {
          "enum": [
            "mysql.exercise.transaction",
            "mysql.exercise.schema",
            "mysql.exercise.insert",
            "mysql.exercise.update",
            "mysql.exercise.delete",
            "mysql.exercise.projection",
            "mysql.exercise.filter",
            "mysql.exercise.distinct-limit",
            "mysql.exercise.group",
            "mysql.exercise.average",
            "mysql.exercise.inner-join",
            "mysql.exercise.left-join"
          ]
        },
        "reviewCase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  ],
  "$defs": {
    "Opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[\\x20-\\x7e]+$"
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "CellNull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "null"
        }
      }
    },
    "CellInt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "int"
        },
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "CellText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "StoredCell": {
      "oneOf": [
        {
          "$ref": "#/$defs/CellNull"
        },
        {
          "$ref": "#/$defs/CellInt"
        },
        {
          "$ref": "#/$defs/CellText"
        }
      ]
    },
    "Column": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "length",
            "nullable",
            "primaryKey",
            "unique",
            "defaultValue"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/Name"
            },
            "type": {
              "const": "int"
            },
            "length": {
              "type": "null"
            },
            "nullable": {
              "type": "boolean"
            },
            "primaryKey": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "defaultValue": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/StoredCell"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "length",
            "nullable",
            "primaryKey",
            "unique",
            "defaultValue"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/Name"
            },
            "type": {
              "const": "varchar"
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "nullable": {
              "type": "boolean"
            },
            "primaryKey": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "defaultValue": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/StoredCell"
                }
              ]
            }
          }
        }
      ]
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/StoredCell"
          }
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns",
        "rows"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      }
    },
    "Database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tables",
        "nextRowId"
      ],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Table"
          }
        },
        "nextRowId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4097
        }
      }
    },
    "Transaction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "base"
          ],
          "properties": {
            "active": {
              "const": false
            },
            "base": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "base"
          ],
          "properties": {
            "active": {
              "const": true
            },
            "base": {
              "$ref": "#/$defs/Database"
            }
          }
        }
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "transaction"
      ],
      "properties": {
        "database": {
          "$ref": "#/$defs/Database"
        },
        "transaction": {
          "$ref": "#/$defs/Transaction"
        }
      }
    }
  }
}
